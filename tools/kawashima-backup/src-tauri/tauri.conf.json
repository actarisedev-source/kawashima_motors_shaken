{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "川島モータース バックアップツール",
  "version": "0.5.0",
  "identifier": "jp.actarise.kawashima.backup",
  "build": {
    "beforeDevCommand": "npm run preview",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "川島モータース バックアップツール",
        "width": 1180,
        "height": 860,
        "minWidth": 920,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "resources/prod-ca-2021.crt"
    ]
  }
}
