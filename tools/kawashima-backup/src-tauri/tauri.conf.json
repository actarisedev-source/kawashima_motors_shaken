{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "川島モータース バックアップツール",
  "version": "0.1.0",
  "identifier": "jp.actarise.kawashima.backup",
  "build": {
    "beforeDevCommand": "npm run preview",
    "beforeBuildCommand": "npm run check && npm run build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "川島モータース バックアップツール",
        "width": 1180,
        "height": 860,
        "minWidth": 920,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": ["resources/prod-ca-2021.crt"]
  }
}
